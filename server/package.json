{
  "name": "unified-devops-server",
  "version": "1.0.0",
  "description": "Unified DevOps Platform — Backend API Server",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker:ci": "node src/workers/ci.worker.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
